{
  "name": "gema-vertex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && pnpm test:sanity",
    "test:watch": "vitest",
    "studio:dev": "pnpm --dir studio dev",
    "studio:build": "pnpm --dir studio build",
    "studio:check": "pnpm --dir studio typecheck && pnpm --dir studio lint && pnpm --dir studio test",
    "sanity:typegen": "pnpm --dir studio typegen",
    "test:sanity": "vitest run --config vitest.sanity.config.mts",
    "sanity:smoke": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sanity-smoke.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@sanity/image-url": "^2.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^5.31.2",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "@sanity/client": "7.28.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "groq-js": "1.30.3",
    "tsx": "4.23.15"
  },
  "packageManager": "pnpm@12.15.0"
}
