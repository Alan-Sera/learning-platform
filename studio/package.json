{
  "name": "@gema-vertex/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy --url gema-vertex --schema-required",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "schema:extract": "sanity schemas extract --path schema.json",
    "typegen": "pnpm schema:extract && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/vision": "5.31.2",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "5.31.2",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.1.0",
    "@types/node": "22.20.5"
  }
}
